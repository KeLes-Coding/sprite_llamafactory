                },
                "required": [
                  "x",
                  "y",
                  "yaw",
                  "step",
                  "degree"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "action",
              "parameters"
            ],
            "additionalProperties": false
          }
        ]
      }
