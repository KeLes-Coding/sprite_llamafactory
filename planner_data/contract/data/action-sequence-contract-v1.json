              },
              "parameters": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1,
                    "description": "正数前进，负数后退。"
                  },
                  "y": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1,
                    "description": "正数左移，负数右移。"
                  },
                  "yaw": {
                    "const": 0
                  },
                  "step": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "x",
                  "y",
                  "yaw",
                  "step"
                ],
                "additionalProperties": false,
                "anyOf": [
                  {
                    "properties": {
                      "x": {
                        "not": {
                          "const": 0
                        }
                      }
                    }
                  },
                  {
                    "properties": {
                      "y": {
                        "not": {
                          "const": 0
                        }
                      }
                    }
                  }
                ]
              }
            },
            "required": [
              "action",
              "parameters"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "walk"
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "x": {
                    "const": 0
                  },
                  "y": {
                    "const": 0
                  },
                  "yaw": {
                    "type": "number",
                    "enum": [
                      -1,
                      1
                    ],
                    "description": "1 表示左转，-1 表示右转。"
                  },
                  "step": {
                    "const": 1
